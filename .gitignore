# Repo-wide ignores only.
# Each project root owns its own build/dependency ignores:
#   web-app/.gitignore   node_modules, dist, *.tsbuildinfo, .env
#   mobile/.gitignore    Flutter build output, Dart config secrets, .env*
#   desktop/.gitignore   Flutter build output, .env*

# Logs
logs
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — repo-wide backstop.
# Every project also ignores its own .env (see above); this rule stays as a net
# so a stray .env anywhere in the tree can never be committed.
.env

# Notion import workflow
FROM_NOTION
supabase/migrations/*_import_notion_goals_*.sql

# Mobile
mobile/back_up_template/*

# Build artifacts and debug symbols
*.dSYM/
*.dSYM.zip
