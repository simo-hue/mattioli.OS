<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- iCloud sync: the same CloudKit container the iOS app uses. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.simo.evolve</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Sync secrets (E2E key + canonical owner) live in the shared group so
	     both apps read the same iCloud-Keychain items; the app's own group
	     stays first so it remains the default for group-less keychain writes
	     (SQLCipher key, owner UUID, Supabase session). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.simo.evolve.evolveDesktop</string>
		<string>$(AppIdentifierPrefix)com.simo.evolve.sync</string>
	</array>
</dict>
</plist>
