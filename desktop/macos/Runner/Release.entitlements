<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit zone-change silent pushes. Value is `development`: Xcode
	     rewrites it to `production` when exporting for distribution, so this is
	     the correct literal to commit. Requires the Push Notifications
	     capability on App ID com.simo.evolve (enabled 2026-07-21) — without it
	     the build fails at the SIGNING step, not at compile. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required to bind the 127.0.0.1 loopback listener that receives the
	     OAuth callback; the sandbox denies the bind without it. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Sign in with Apple: required for the native macOS credential flow
	     (SignInWithApple.getAppleIDCredential). Without it the request is
	     denied before it reaches Supabase and the UI shows "Apple
	     authentication failed". Mirrors mobile/ios/Runner/Runner.entitlements;
	     both apps share the App ID com.simo.evolve, whose Sign in with Apple
	     capability is already enabled in the Apple Developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- iCloud sync: the same CloudKit container the iOS app uses. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.simo.evolve</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Pin the CloudKit environment explicitly instead of letting the signing
	     identity choose it — the implicit choice is exactly how a dev build and a
	     TestFlight build once landed in different datastores (dev data stranded
	     in Development, invisible to a Production build). Release → Production.
	     An App Store Connect build's distribution profile forces Production
	     anyway, so here this is belt-and-suspenders; its real job is that a
	     locally-archived Release build can no longer silently bind to
	     Development. The Debug/Profile entitlements pin Development, keeping dev
	     testing isolated from the production zone. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- Sync secrets (E2E key + canonical owner) live in the shared group so
	     both apps read the same iCloud-Keychain items; the app's own group
	     stays first so it remains the default for group-less keychain writes
	     (SQLCipher key, owner UUID, Supabase session). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.simo.evolve</string>
		<string>$(AppIdentifierPrefix)com.simo.evolve.sync</string>
	</array>
</dict>
</plist>
