default_platform(:mac)

platform :mac do
  desc "Build and upload a new macOS release to App Store Connect"
  lane :release do
    # Requires Xcode to be configured with "Automatically manage signing"
    # and the Mac App Distribution profiles downloaded.
    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    
    upload_to_app_store(
      app_identifier: "com.simo.evolve",
      # MANDATORY. `deliver` defaults platform to "ios", and com.simo.evolve is
      # one Universal Purchase record holding BOTH platforms -- so omitting this
      # pushes the macOS metadata onto the LIVE iOS listing.
      platform: "osx",
      # Screenshots are managed by hand in App Store Connect; there is no
      # fastlane/screenshots directory here. Without this, deliver can clear the
      # Mac screenshots already uploaded to the version.
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Push macOS App Store metadata only (no build): descriptions + review notes"
  lane :metadata do
    # Used to fix Guideline 3.1.2(c): the Terms of Use (EULA) link lives in the
    # App Description, which means the description of EVERY localisation has to
    # carry it. Run this, then verify in App Store Connect before submitting.
    upload_to_app_store(
      app_identifier: "com.simo.evolve",
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Build the .pkg for Transporter upload"
  lane :build_for_transporter do
    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    UI.success("The .pkg has been built and is ready for Transporter!")
  end

  desc "Aggiorna 'What's New in This Version' per macOS"
  lane :update_notes do
    ENV['FASTLANE_ITC_TEAM_ID'] = "128920131"
    Spaceship::ConnectAPI.login("mattioli.simone.10@gmail.com")
    app = Spaceship::ConnectAPI::App.find("com.simo.evolve")
    
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    
    if version.nil?
      UI.user_error!("Nessuna versione macOS in stato editabile trovata!")
    end
    
    UI.success("Trovata versione in modifica: #{version.version_string}")
    required_locales = ["fr-FR", "vi", "ko", "en-AU", "es-MX", "id", "en-CA", "de-DE", "sk", "sv", "da", "fr-CA", "pt-PT", "he", "el", "en-GB"]
    
    existing_locs = version.get_app_store_version_localizations
    existing_locales = existing_locs.map(&:locale)
    
    all_locales = (required_locales + existing_locales).uniq
    UI.message("Lingue da aggiornare: #{all_locales.join(', ')}")
    
    # Read from fastlane/metadata/<locale>/release_notes.txt -- the SAME files
    # `deliver` uploads in the `release` and `metadata` lanes.
    #
    # This used to be a hardcoded 18-language table, and it had drifted from
    # what the app shipped: it still described 1.3.0 while the iOS lane had
    # long since moved its notes into one source. Two trees holding two
    # generations of the copy is the exact failure the iOS Fastfile's header
    # documents, so the table is gone: one source, no hand copying.
    metadata_path = File.expand_path('metadata', __dir__)
    notes_for = lambda do |locale|
      candidates = [locale]
      # Any shipped locale of the same language (App Store Connect asks for
      # en-CA; the tree may only carry en-US), then English.
      language = locale.split('-').first
      candidates += Dir.children(metadata_path)
                       .select { |d| d.split('-').first == language }
                       .sort
      candidates << 'en-US'
      path = candidates
        .map { |code| File.join(metadata_path, code, 'release_notes.txt') }
        .find { |file| File.exist?(file) }
      UI.user_error!("No release_notes.txt for #{locale} and no en-US fallback") if path.nil?
      # `encoding: 'UTF-8'` explicitly: the Arabic notes raise
      # Encoding::InvalidByteSequenceError under a non-UTF-8 shell locale.
      File.read(path, encoding: 'UTF-8').strip
    end

    all_locales.each do |locale|
      localized_whats_new = notes_for.call(locale)
      
      begin
        if existing_locales.include?(locale)
          UI.message("Aggiorno lingua esistente: #{locale}...")
          loc = existing_locs.find { |l| l.locale == locale }
          loc.update(attributes: { whatsNew: localized_whats_new })
        else
          UI.message("Creo nuova localizzazione per versione: #{locale}...")
          Spaceship::ConnectAPI.post_app_store_version_localization(
            app_store_version_id: version.id,
            attributes: {
              locale: locale,
              whatsNew: localized_whats_new
            }
          )
        end
      rescue => ex
        UI.important("Non aggiornato per #{locale}: #{ex.message}. Se e' la v1.0, Apple non supporta What's New.")
      end
    end
    
    UI.success("Completato l'aggiornamento dei metadati macOS (se consentito).")
  end
end
