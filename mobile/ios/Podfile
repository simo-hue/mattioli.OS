# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  # Silence warnings from third-party pods — none of this source is ours to fix.
  # It lives in ~/.pub-cache and the CocoaPods trunk repo, so a local edit is undone
  # by the next `pub get`/`pod install`, and both offenders are unfixable upstream too:
  #   - SQLCipher/FMDB: ~250 warnings from the sqlite3.c amalgamation (i64->int
  #     narrowing, ambiguous MIN/MAX, a #warning that gethostuuid() is unavailable
  #     on iOS). Generated code; sqflite_sqlcipher pins SQLCipher to 4.10.0 exactly.
  #   - permission_handler_apple: PhonePermissionStrategy.m reads CTCarrier /
  #     serviceSubscriberCellularProviders / mobileNetworkCode, all deprecated in
  #     iOS 16 with no replacement. Still present unguarded on upstream main
  #     (checked 2026-07-30, latest 9.4.10), and there is no PERMISSION_PHONE macro
  #     to compile the file out — so it warns even though this app only ever asks
  #     for Permission.notification. Upgrading does not help.
  # Runner and DeviceActivityMonitorExtension keep their warnings; only Pods go quiet.
  # Matches desktop/macos/Podfile, where this same line silenced the same SQLCipher noise.
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
  # Suppress "Update to recommended settings" on the generated Pods project.
  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2660'
end
