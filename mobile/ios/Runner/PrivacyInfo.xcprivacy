<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App-level Apple Privacy Manifest (required since 2024; ITMS-91053).
	  Declares (1) data collected by first-party code and (2) "required reason"
	  APIs used by the app / statically-linked code that does not ship its own
	  manifest. Bundled Pods (Sentry, SQLCipher, GoogleSignIn, …) ship their own
	  PrivacyInfo.xcprivacy and are aggregated automatically — do not duplicate
	  them here.

	  IMPORTANT: NSPrivacyCollectedDataTypes below must stay consistent with the
	  App Store Connect privacy "nutrition labels". Profile photos are stored
	  only on-device (never uploaded) and are intentionally NOT declared.

	  HealthKit: Health IS declared below. The data minimisation described here is
	  real and still holds — a HealthKit rule's measured quantity (steps, sleep
	  hours, active kcal, …) decides a habit's daily verdict and is persisted only
	  by the private backend: the on-device SQLCipher database and, if the user
	  enables sync, the user's own CloudKit private container, AES-GCM encrypted
	  under a key we never hold. Both Supabase writers of goal_logs.value null it
	  out for a HealthKit-verified goal — HabitLogsNotifier.applyAutoVerdict (the
	  reconcile pass) and stripHealthMeasurements (the Cloud-mode backup restore)
	  — so no measured quantity reaches a server we can read. What DOES reach
	  Supabase is the verdict (goal_logs.status) and the rule behind it
	  (goals.verify_*): "hit the 10000-step target on 2026-07-14" without the
	  count.

	  This file previously declared no Health type, on the reading that such a
	  verdict is habit state rather than collected health data. That reading is
	  coherent but unsettled — a per-habit "verified: true" derived from step
	  counts, uploaded and tied to an account, is still a health-derived signal
	  about a user — and the risk is asymmetric: declaring costs one nutrition
	  label row, while not declaring costs a rejection cycle and reads as
	  concealment on a build already rejected under Guideline 2.5.1. So we
	  declare, and keep the nuance recorded here.

	  Health, not Fitness: every type we read comes from the HealthKit API, which
	  Apple's own definition places under Health. The Motion & Fitness API is not
	  used, so declaring Fitness would name a source we never touch.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address: Supabase email/password, Google & Apple sign-in -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Name: user profile display name -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: Supabase account identifier -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other user content: goal/habit titles and descriptions the user
		     writes, uploaded to Supabase in Cloud mode; titles are additionally
		     sent to openrouter.ai by the AI coach -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Health: HealthKit types read for auto-verified habits (steps, exercise
		     minutes, active energy, walking/running distance, stand hours, mindful
		     minutes, sleep, workouts). Read-only — the app never writes a sample.
		     Linked, because the resulting verdict is stored against the account in
		     Cloud mode. See the note at the top of this file: the measured quantity
		     itself never reaches a server we can read. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Purchase history: RevenueCat subscription / entitlement state -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Crash data: Sentry (disabled entirely in Private Mode) -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Performance data: Sentry performance tracing -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- shared_preferences → NSUserDefaults (app-internal data only) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- File timestamps: private SQLCipher DB + avatar files inside the app container -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
