<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit zone-change silent pushes. Value is `development`: Xcode
	     rewrites it to `production` when exporting for distribution, so this is
	     the correct literal to commit. Requires the Push Notifications
	     capability on App ID com.simo.evolve (enabled 2026-07-21) — without it
	     the build fails at the SIGNING step, not at compile. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.developer.family-controls.app-and-website-usage</key>
	<true/>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.simo.evolve</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.simo.evolve.verification</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.simo.evolve</string>
		<string>$(AppIdentifierPrefix)com.simo.evolve.sync</string>
	</array>
</dict>
</plist>
