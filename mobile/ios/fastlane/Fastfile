require 'spaceship'

default_platform(:ios)

# The ONE metadata tree that ships. It lives at mobile/metadata, not under
# fastlane/, because it carries the full field set (categories, copyright, URLs)
# that a bare fastlane/metadata folder does not.
#
# There used to be a second tree at mobile/ios/fastlane/metadata holding a
# different generation of the copy. The two drifted, text was moved between them
# by hand, and the hand copying truncated five localisations at the 4000
# character ceiling -- taking the Terms of Use (EULA) link with it, because the
# legal block sat at the end of the file. That is what got iOS 1.1.2 rejected
# under Guideline 3.1.2(c), twice. The second tree is deleted. Do not recreate
# it, and do not run `deliver` without passing this path explicitly.
METADATA_PATH = File.expand_path('../../metadata', __dir__)

platform :ios do
  desc 'Validate App Store metadata. Runs before any upload, and in CI.'
  lane :validate_metadata do
    sh("python3 #{File.expand_path('../../tool/appstore/validate_metadata.py', __dir__)}")
  end

  desc 'Upload App Store metadata (no binary). Validates first and aborts on failure.'
  lane :upload_metadata do
    # Gate first. A failed upload leaves some localisations updated and others
    # stale, which is a worse state than not having run at all.
    validate_metadata

    deliver(
      metadata_path: METADATA_PATH,
      skip_binary_upload: true,
      skip_screenshots: true,
      # Never auto-submit. Metadata goes up, then the submission is reviewed by
      # a human against the App Review notes before it is sent to Apple.
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Aggiorna 'What's New in This Version' per tutte le lingue"
  lane :update_notes do
    ENV['FASTLANE_ITC_TEAM_ID'] = "128920131"
    Spaceship::ConnectAPI.login("mattioli.simone.10@gmail.com")
    app = Spaceship::ConnectAPI::App.find("com.simo.evolve")
    version = app.get_edit_app_store_version
    
    if version.nil?
      UI.user_error!("Nessuna versione in stato editabile trovata!")
    end
    
    UI.success("Trovata versione in modifica: #{version.version_string}")
    required_locales = ["fr-FR", "vi", "ko", "en-AU", "es-MX", "id", "en-CA", "de-DE", "sk", "sv", "da", "fr-CA", "pt-PT", "he", "el", "en-GB"]
    
    existing_locs = version.get_app_store_version_localizations
    existing_locales = existing_locs.map(&:locale)
    
    all_locales = (required_locales + existing_locales).uniq
    UI.message("Lingue da aggiornare: #{all_locales.join(', ')}")
    
    translations = {
      "it" => "Miglioramenti alla sicurezza e correzione di bug.",
      "en" => "We've added dates to the Goals header, improved the Overview page, squashed sync and timezone bugs, and made several other stability enhancements.",
      "fr" => "Améliorations de la sécurité et corrections de bugs.",
      "vi" => "Cải tiến bảo mật và sửa lỗi.",
      "ko" => "보안 강화 및 버그 수정.",
      "es" => "Mejoras de seguridad y corrección de errores.",
      "id" => "Peningkatan keamanan dan perbaikan bug.",
      "de" => "Sicherheitsverbesserungen und Fehlerbehebungen.",
      "sk" => "Vylepšenia zabezpečenia a opravy chýb.",
      "sv" => "Säkerhetsförbättringar och buggfixar.",
      "da" => "Sikkerhedsforbedringer og fejlrettelser.",
      "pt" => "Melhorias de segurança e correção de bugs.",
      "he" => "שיפורי אבטחה ותיקוני באגים.",
      "el" => "Βελτιώσεις ασφαλείας και διορθώσεις σφαλμάτων.",
      "zh" => "安全增强和错误修复。",
      "ja" => "セキュリティの向上とバグ修正。",
      "ru" => "Улучшения безопасности и исправление ошибок.",
      "ar" => "تحسينات الأمان وإصلاح الأخطاء."
    }
    
    all_locales.each do |locale|
      lang_code = locale.split('-').first
      localized_whats_new = translations[lang_code] || translations["en"]
      
      if existing_locales.include?(locale)
        UI.message("Aggiorno lingua esistente: #{locale} con testo: #{localized_whats_new}...")
        loc = existing_locs.find { |l| l.locale == locale }
        loc.update(attributes: { whatsNew: localized_whats_new })
      else
        UI.message("Creo nuova localizzazione per versione: #{locale} con testo: #{localized_whats_new}...")
        Spaceship::ConnectAPI.post_app_store_version_localization(
          app_store_version_id: version.id,
          attributes: {
            locale: locale,
            whatsNew: localized_whats_new
          }
        )
      end
    end
    
    UI.success("Completato! Tutte le lingue richieste sono state aggiornate.")
  end
end
