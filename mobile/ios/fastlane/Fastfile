require 'spaceship'

default_platform(:ios)

platform :ios do
  desc "Aggiorna 'What's New in This Version' per tutte le lingue"
  lane :update_notes do
    ENV['FASTLANE_ITC_TEAM_ID'] = "128920131"
    Spaceship::ConnectAPI.login("mattioli.simone.10@gmail.com")
    app = Spaceship::ConnectAPI::App.find("com.simo.evolve")
    version = app.get_edit_app_store_version
    
    if version.nil?
      UI.user_error!("Nessuna versione in stato editabile trovata!")
    end
    
    UI.success("Trovata versione in modifica: #{version.version_string}")
    required_locales = ["fr-FR", "vi", "ko", "en-AU", "es-MX", "id", "en-CA", "de-DE", "sk", "sv", "da", "fr-CA", "pt-PT", "he", "el", "en-GB"]
    
    existing_locs = version.get_app_store_version_localizations
    existing_locales = existing_locs.map(&:locale)
    
    all_locales = (required_locales + existing_locales).uniq
    UI.message("Lingue da aggiornare: #{all_locales.join(', ')}")
    
    translations = {
      "it" => "Nuova UI",
      "en" => "New UI",
      "fr" => "Nouvelle interface utilisateur",
      "vi" => "Giao diện người dùng mới",
      "ko" => "새로운 UI",
      "es" => "Nueva interfaz de usuario",
      "id" => "UI Baru",
      "de" => "Neue Benutzeroberfläche",
      "sk" => "Nové používateľské rozhranie",
      "sv" => "Nytt användargränssnitt",
      "da" => "Ny brugergrænseflade",
      "pt" => "Nova interface de utilizador",
      "he" => "ממשק משתמש חדש",
      "el" => "Νέο περιβάλλον χρήστη",
      "zh" => "全新的 UI 界面",
      "ja" => "新しいUI",
      "ru" => "Новый интерфейс",
      "ar" => "واجهة مستخدم جديدة"
    }
    
    all_locales.each do |locale|
      lang_code = locale.split('-').first
      localized_whats_new = translations[lang_code] || translations["en"]
      
      if existing_locales.include?(locale)
        UI.message("Aggiorno lingua esistente: #{locale} con testo: #{localized_whats_new}...")
        loc = existing_locs.find { |l| l.locale == locale }
        loc.update(attributes: { whatsNew: localized_whats_new })
      else
        UI.message("Creo nuova localizzazione per versione: #{locale} con testo: #{localized_whats_new}...")
        Spaceship::ConnectAPI.post_app_store_version_localization(
          app_store_version_id: version.id,
          attributes: {
            locale: locale,
            whatsNew: localized_whats_new
          }
        )
      end
    end
    
    UI.success("Completato! Tutte le lingue richieste sono state aggiornate.")
  end
end
